generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                Int                 @id @default(autoincrement())
  authProvider      String              @db.VarChar(32)
  authSubject       String              @db.VarChar(255)
  email             String?
  displayName       String?
  lichessConnection LichessConnection?
  oauthLoginStates  OAuthLoginState[]
  importedGames     ImportedGame[]
  importRuns        ImportRun[]
  importCoverages   AccountImportCoverage[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([authProvider, authSubject])
}

model LichessConnection {
  id                    Int      @id @default(autoincrement())
  appUserId             Int      @unique
  appUser               AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  lichessUserId         String   @unique @db.VarChar(64)
  username              String   @db.VarChar(64)
  scopes                String[] @default([])
  accessTokenCiphertext String
  accessTokenIv         String
  accessTokenAuthTag    String
  expiresAt             DateTime?
  connectedAt           DateTime @default(now())
  revokedAt             DateTime?
  credentialGeneration  String   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([username])
}

model OAuthLoginState {
  id           Int      @id @default(autoincrement())
  appUserId    Int
  appUser      AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  provider     String   @db.VarChar(32)
  state        String   @unique @db.VarChar(128)
  codeVerifier String?  @db.VarChar(256)
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  consumedAt   DateTime?

  @@index([appUserId, provider])
  @@index([expiresAt])
}

model ImportedGame {
  id                         Int                   @id @default(autoincrement())
  appUserId                  Int
  appUser                    AppUser               @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  provider                   String                @db.VarChar(32)
  providerGameId             String                @db.VarChar(128)
  providerUrl                String?
  source                     String                @default("LICHESS_API") @db.VarChar(64)
  connectedLichessUserId     String                @db.VarChar(64)
  connectedLichessUsername   String                @db.VarChar(64)
  pgn                        String?
  rated                      Boolean?
  variant                    String?               @db.VarChar(32)
  speedCategory              String?               @db.VarChar(32)
  performanceCategory        String?               @db.VarChar(32)
  timeControlRaw             String?
  timeControlInitial         Int?
  timeControlIncrement       Int?
  timeControlSource          String                @default("UNKNOWN") @db.VarChar(32)
  exactTimeControlKey        String?               @db.VarChar(128)
  startedAt                  DateTime?
  endedAt                    DateTime?
  whiteUsername              String?
  blackUsername              String?
  whiteRating                Int?
  blackRating                Int?
  userColor                  String?               @db.VarChar(8)
  opponentUsername           String?
  result                     String?               @db.VarChar(16)
  resultForUser              String?               @db.VarChar(16)
  status                     String?               @db.VarChar(32)
  openingName                String?
  openingEco                 String?               @db.VarChar(16)
  rawClockPresence           String                @default("ABSENT") @db.VarChar(16)
  rawClockStateCount         Int                   @default(0)
  rawClockUnit               String                @default("CENTISECONDS") @db.VarChar(24)
  rawClockAnomalies          Json?
  plyIndexStatus             String                @default("PENDING") @db.VarChar(24)
  plyIndexPolicyVersion      Int?
  plyIndexedAt               DateTime?
  plyIndexError              String?
  indexedRawClockStateCount  Int                   @default(0)
  clockAlignmentStatus       String                @default("UNAVAILABLE") @db.VarChar(24)
  clockAlignmentVersion      Int?
  alignedClockPlyCount       Int                   @default(0)
  timingDerivationVersion    Int?
  derivedTimingPlyCount      Int                   @default(0)
  timingCoverageStatus       String                @default("UNAVAILABLE") @db.VarChar(24)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  rawClockStates             LichessClockState[]
  plies                      ImportedGamePly[]
  terminalClockFacts         TerminalClockSourceFact[]
  analysisRuns               GameAnalysisRun[]

  @@unique([appUserId, provider, providerGameId])
  @@index([appUserId, startedAt])
  @@index([appUserId, provider, connectedLichessUserId])
  @@index([plyIndexStatus, updatedAt])
}

model LichessClockState {
  id                  Int          @id @default(autoincrement())
  importedGameId      Int
  importedGame        ImportedGame @relation(fields: [importedGameId], references: [id], onDelete: Cascade)
  provider            String       @default("LICHESS") @db.VarChar(32)
  sourceOrdinal       Int
  valueCentiseconds   Int
  createdAt           DateTime     @default(now())

  @@unique([importedGameId, sourceOrdinal])
  @@index([importedGameId, sourceOrdinal])
}

model Position {
  id              Int                         @id @default(autoincrement())
  positionKey     Bytes                       @unique
  normalizedFen   String                      @unique
  createdAt       DateTime                    @default(now())
  pliesBefore     ImportedGamePly[]           @relation("PlyBeforePosition")
  pliesAfter      ImportedGamePly[]           @relation("PlyAfterPosition")
  engineAnalyses  StockfishPositionAnalysis[]
}

model ImportedGamePly {
  importedGameId                  Int
  importedGame                    ImportedGame     @relation(fields: [importedGameId], references: [id], onDelete: Cascade)
  plyNumber                       Int
  beforePositionId                Int
  beforePosition                  Position         @relation("PlyBeforePosition", fields: [beforePositionId], references: [id], onDelete: Restrict)
  afterPositionId                 Int
  afterPosition                   Position         @relation("PlyAfterPosition", fields: [afterPositionId], references: [id], onDelete: Restrict)
  moveUci                         String           @db.VarChar(16)
  moverColor                      String           @db.VarChar(8)
  isUserMove                      Boolean
  sourceClockOrdinal              Int?
  sourceClockAfterCentiseconds    Int?
  sourceClockSemantics            String?          @db.VarChar(40)
  clockAlignmentVersion           Int?
  clockBeforeMoveCentiseconds     Int?
  effectiveIncrementCentiseconds  Int?
  clockDeltaMoveTimeCentiseconds  Int?
  beforeClockProvenance           String           @default("UNAVAILABLE") @db.VarChar(40)
  incrementProvenance             String           @default("UNAVAILABLE") @db.VarChar(40)
  timingDerivationVersion         Int?
  timingDerivationStatus          String           @default("UNAVAILABLE") @db.VarChar(24)
  timingReliabilityFlags          String[]         @default([])
  timingUnavailableReason         String?          @db.VarChar(64)
  engineAnalysisRunId             Int?
  engineAnalysisRun               GameAnalysisRun? @relation(fields: [engineAnalysisRunId], references: [id], onDelete: SetNull)
  scoreLossCp                     Int?
  classificationCode              Int?
  createdAt                       DateTime         @default(now())

  @@id([importedGameId, plyNumber])
  @@index([beforePositionId])
  @@index([afterPositionId])
  @@index([importedGameId, timingDerivationStatus])
  @@index([engineAnalysisRunId])
}

model TerminalClockSourceFact {
  id                  Int          @id @default(autoincrement())
  importedGameId      Int
  importedGame        ImportedGame @relation(fields: [importedGameId], references: [id], onDelete: Cascade)
  sourceOrdinal       Int
  activeColor         String       @db.VarChar(8)
  valueCentiseconds   Int
  semantics           String       @db.VarChar(48)
  alignmentVersion    Int
  createdAt           DateTime     @default(now())

  @@unique([importedGameId, sourceOrdinal])
  @@index([importedGameId])
}

model GameAnalysisRun {
  id                  Int               @id @default(autoincrement())
  importedGameId      Int
  importedGame        ImportedGame      @relation(fields: [importedGameId], references: [id], onDelete: Cascade)
  snapshotId          String            @unique @default(cuid()) @db.VarChar(32)
  analysisVersion     String            @db.VarChar(64)
  settingsHash        String            @db.VarChar(64)
  settingsJson        Json
  engineName          String?           @db.VarChar(128)
  engineVersion       String?           @db.VarChar(64)
  status              String            @default("QUEUED") @db.VarChar(24)
  coverageStatus      String            @default("PENDING") @db.VarChar(24)
  positionsTotal      Int               @default(0)
  positionsDone       Int               @default(0)
  pliesTotal          Int               @default(0)
  pliesDone           Int               @default(0)
  cacheHits           Int               @default(0)
  cacheMisses         Int               @default(0)
  attempts            Int               @default(0)
  maxAttempts         Int               @default(3)
  runAfter            DateTime          @default(now())
  workerId            String?           @db.VarChar(128)
  claimToken          String?           @db.VarChar(64)
  claimedAt           DateTime?
  heartbeatAt         DateTime?
  cancelRequestedAt   DateTime?
  error               String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  analysedPlies       ImportedGamePly[]

  @@index([status, runAfter])
  @@index([importedGameId, status, createdAt])
  @@index([importedGameId, analysisVersion, settingsHash])
}

model StockfishPositionAnalysis {
  id              Int      @id @default(autoincrement())
  positionId      Int
  position        Position @relation(fields: [positionId], references: [id], onDelete: Restrict)
  analysisVersion String   @db.VarChar(64)
  engineName      String   @db.VarChar(128)
  engineVersion   String   @db.VarChar(64)
  settingsHash    String   @db.VarChar(64)
  depth           Int
  scoreCpWhite    Int?
  mateWhite       Int?
  bestMove        String?  @db.VarChar(16)
  bestPv          String[] @default([])
  multiPvJson     Json
  rawInfoJson     Json
  createdAt       DateTime @default(now())

  @@unique([positionId, analysisVersion, settingsHash, engineName, engineVersion], map: "StockfishPositionAnalysis_cache_key")
  @@index([analysisVersion, settingsHash, engineName, engineVersion], map: "StockfishPositionAnalysis_provenance_idx")
}

model ImportRun {
  id                       Int                    @id @default(autoincrement())
  appUserId                Int
  appUser                  AppUser                @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  provider                 String                 @db.VarChar(32)
  mode                     String                 @default("BOUNDED_INITIAL") @db.VarChar(32)
  source                   String                 @default("LICHESS_API") @db.VarChar(64)
  status                   String                 @default("QUEUED") @db.VarChar(24)
  scopeVersion             Int                    @default(1)
  scopeHash                String                 @db.VarChar(64)
  scopeJson                Json
  requestedFrom            DateTime
  requestedTo              DateTime
  lichessUserIdSnapshot    String                 @db.VarChar(64)
  lichessUsernameSnapshot  String                 @db.VarChar(64)
  checkpointJson           Json?
  windowsTotal             Int                    @default(0)
  windowsCompleted         Int                    @default(0)
  gamesSeen                Int                    @default(0)
  gamesMatchedScope        Int                    @default(0)
  gamesImported            Int                    @default(0)
  gamesDuplicate           Int                    @default(0)
  gamesUpdated             Int                    @default(0)
  gamesSkipped             Int                    @default(0)
  gamesSkippedOutOfScope   Int                    @default(0)
  gamesFailed              Int                    @default(0)
  lastProgressAt           DateTime?
  workKey                  String                 @unique
  claimedAt                DateTime?
  heartbeatAt              DateTime?
  cancelRequestedAt        DateTime?
  rateLimitUntil           DateTime?
  errorCode                String?                @db.VarChar(64)
  error                    String?
  startedAt                DateTime?
  completedAt              DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt

  @@index([appUserId, status, createdAt])
  @@index([status, heartbeatAt])
}

model AccountImportCoverage {
  id                       Int      @id @default(autoincrement())
  appUserId                Int
  appUser                  AppUser  @relation(fields: [appUserId], references: [id], onDelete: Cascade)
  scopeVersion             Int
  scopeHash                String   @db.VarChar(64)
  scopeJson                Json
  coveredFrom              DateTime?
  coveredThrough           DateTime?
  lastCompletedImportRunId Int?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@unique([appUserId, scopeHash])
  @@index([appUserId, coveredThrough])
}
