DATABASE_URL=postgresql://postgres:postgres@localhost:5432/why_i_suck_at_chess
PORT=3000
WEB_APP_URL=http://localhost:4200

# AUTH_MODE is required. Use dev-single-user only for explicit local development.
AUTH_MODE=dev-single-user
# Production auth example:
# AUTH_MODE=clerk
# CLERK_JWT_ISSUER=https://example.clerk.accounts.dev
# CLERK_JWKS_URL=https://example.clerk.accounts.dev/.well-known/jwks.json
# CLERK_JWT_AUDIENCE=
# CLERK_AUTHORIZED_PARTIES=http://localhost:4200

LICHESS_OAUTH_CLIENT_ID=
LICHESS_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/lichess/callback
# Generate with: openssl rand -base64 32
LICHESS_TOKEN_ENCRYPTION_KEY=
